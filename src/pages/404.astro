---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import field from '../assets/photos/pumpkin-field-dusk.jpg';
---

<Base title="Off the patch" description="That page is not on the farm. Head back to Zivi’s Farm and the pumpkin patch." noindex>
  <PageHero
    src={field}
    alt="A single orange pumpkin in the foreground of a wide field, wind turbines faint on the horizon."
    position="wagon"
    align="end"
  >
    <h1>Looks like you wandered off the patch.</h1>
    <p>The pumpkins are back this way.</p>
    <p><a class="btn" href="/">Back to the farm</a></p>
  </PageHero>
</Base>
