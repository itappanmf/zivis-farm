---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import DeckledPhoto from '../components/DeckledPhoto.astro';
import ScriptCaption from '../components/ScriptCaption.astro';
import HoursCard from '../components/HoursCard.astro';
import type { ImageMetadata } from 'astro';

import field from '../assets/photos/pumpkin-field-dusk.jpg';
import wagon from '../assets/photos/hayride-from-behind.jpg';
import tractor from '../assets/photos/hayride-tractor-dog.jpg';
import booth from '../assets/photos/face-paint-booth.jpg';
import bunny from '../assets/photos/girl-with-bunny.jpg';
import corn from '../assets/photos/corn-tunnel.jpg';
import cups from '../assets/photos/smores-cups.jpg';
import kits from '../assets/photos/carving-kits.jpg';
import swing from '../assets/photos/scarecrow-swing.jpg';
import garage from '../assets/photos/garage-photo-spot.jpg';

const description =
  'U-pick pumpkins and gourds, tractor hayrides, face painting, and s’mores at Zivi’s Farm, a pumpkin patch near Colorado Springs, Black Forest, Falcon, and Peyton.';

const activities: {
  title: string;
  text: string;
  caption: string;
  src: ImageMetadata;
  alt: string;
}[] = [
  {
    title: 'Pick a pumpkin',
    text: 'The field is heirloom pumpkins and gourds, including the warty ones and the pale ones. You choose. We price it in the patch, and we will tell you the number before it is yours.',
    caption: 'the odd ones count',
    src: field,
    alt: 'Pumpkins of every color scattered through dry grass at dusk, a red tractor parked at the far edge.',
  },
  {
    title: 'Ride the wagon',
    text: 'A Kubota pulls a wagon of hay bales out to the rows and back again. The ride is short. The sky is not. The farm dog rides in the driver’s lap and believes this is his job.',
    caption: 'he thinks he is driving',
    src: tractor,
    alt: 'A man in a cowboy hat driving an orange tractor, a black dog standing across his lap, hay wagon behind.',
  },
  {
    title: 'Get your face painted',
    text: 'Metamorphaces sets up under the tent. Tigers, butterflies, a stripe of blue across a cheek. There is a chair, a mirror full of paints, and no appointment. A little patience is the whole ticket.',
    caption: 'paint, then the mirror',
    src: booth,
    alt: 'A face-painting booth under a lavender canopy, with a Metamorphaces truck painted with a leopard, a dragon, and a unicorn.',
  },
  {
    title: 'Hold the bunny',
    text: 'One very soft bunny, used to being held. Gentle hands. Let them hop down when they have had enough. They are not a photo prop so much as a neighbor who tolerates admiration.',
    caption: 'gentle hands',
    src: bunny,
    alt: 'A child hugging a brown and white lop-eared rabbit, blue paint still on their cheek.',
  },
  {
    title: 'Wander the corn tunnel',
    text: 'Dried corn stalks tied into a tunnel, just tall enough for the little ones. It is a place to crawl and a place to take a picture. It is not a maze, and nobody gets lost.',
    caption: 'just their size',
    src: corn,
    alt: 'A baby in a cream sweater crawling through a tunnel of dried corn stalks beside a yellow trailer.',
  },
  {
    title: 'Stay for s’mores',
    text: 'Kits in a paper cup: chocolate, graham, marshmallow, and a stick. For the fire, if we have one going, or to take to your own. The light is best when you are in no hurry.',
    caption: 'chocolate, graham, a stick',
    src: cups,
    alt: 'Paper cups filled with s’mores kits, each with a Hershey bar, graham crackers, and a roasting stick.',
  },
  {
    title: 'Take a carving kit home',
    text: 'If you would rather carve at the kitchen table, the kits are on the stand. A saw, a scoop, a pattern, and the pumpkin you already picked. The sticker on the big one says the year, so you remember which fall it was.',
    caption: 'for the kitchen table',
    src: kits,
    alt: 'Pumpkin carving kits in a red bin, with a large pumpkin wearing a Zivi’s Farm 2026 sticker and small decorative pumpkins on the table.',
  },
  {
    title: 'Swing a while',
    text: 'A swing set at the edge of the grass, and a scarecrow in a green hat who does not mind the company. The turbines turn behind her. This is a good place to wait for the wagon.',
    caption: 'she keeps watch',
    src: swing,
    alt: 'A handmade scarecrow in an orange jumper and green hat, standing in front of a swing set with wind turbines on the horizon.',
  },
  {
    title: 'Stop at the garage door',
    text: 'The door is dressed for the season: ghosts on a string, hay bales, corn stalks, and a row of pumpkins. It is where everyone ends up for a picture before the drive home.',
    caption: 'the Saturday portrait',
    src: garage,
    alt: 'A white garage door decorated with a garland of little ghosts and pumpkins, hay bales and corn stalks in front.',
  },
];

const bring = [
  'A layer. The sun is strong and the prairie wind finds you.',
  'Sturdy shoes. The patch is grass and dirt, not a path.',
  'A card, and a little cash, until we post how the stand likes to be paid.',
  'Water. Especially if you asked about the dog and we said yes.',
  'Arms, or your own small wagon, for the pumpkin you refuse to put down.',
];
---

<Base title="Pumpkin Patch in Colorado Springs" description={description} includeEvent>
  <PageHero
    src={wagon}
    alt="A hay wagon crossing open prairie, the people small against a huge blue sky and a line of wind turbines."
    position="high"
  >
    <p class="eyebrow">Fall on the prairie</p>
    <h1>The patch, and everything around it</h1>
    <p>Hayrides, heirloom pumpkins, and the kind of afternoon that does not need a schedule.</p>
  </PageHero>

  <section class="section">
    <div class="wrap-narrow">
      <p class="lede">
        You ride out, you walk the rows, you pick the one. The paint, the bunny, the corn stalks, and the s’mores are
        here if you want them. Nothing is a performance. It is a farm, open for the weekend.
      </p>
    </div>
  </section>

  <section class="section" style="padding-top: 0">
    <div class="wrap">
      {
        activities.map((item, index) => (
          <article class:list={['feature', index % 2 === 1 && 'is-flip']}>
            <DeckledPhoto src={item.src} alt={item.alt}>
              <ScriptCaption>{item.caption}</ScriptCaption>
            </DeckledPhoto>
            <div class="feature-copy">
              <h2>{item.title}</h2>
              <p>{item.text}</p>
            </div>
          </article>
        ))
      }

      <div class="wrap-narrow">
        <h2>What to bring</h2>
        <ul class="bring">
          {bring.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <HoursCard />
    </div>
  </section>
</Base>
