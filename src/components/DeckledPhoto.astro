---
import type { ImageMetadata } from 'astro';
import FarmPhoto from './FarmPhoto.astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes?: string;
  priority?: boolean;
}

const { src, alt, sizes = '(min-width: 840px) 36rem, 92vw', priority = false } = Astro.props;
---

<figure class="deckled">
  <FarmPhoto src={src} alt={alt} sizes={sizes} priority={priority} widths={[480, 720]} />
  {
    Astro.slots.default && (
      <figcaption>
        <slot />
      </figcaption>
    )
  }
</figure>
