---
import { mapsUrl, site } from '../data/site';
---

<section class="hours-card" aria-label="Hours and address">
  <div>
    <p class="eyebrow">This weekend</p>
    <ul class="hours-list">
      {
        site.hours.map((day) => (
          <li>
            <span>{day.day}</span>
            <span>{day.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
  <div>
    <address>
      {site.address.street}<br />
      {site.address.city}, {site.address.region}
      {site.address.postalCode}
    </address>
    <p>
      <a href={site.phoneTel}>{site.phoneDisplay}</a><br />
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </p>
    <a class="btn" href={mapsUrl} rel="noopener noreferrer">Get directions</a>
  </div>
</section>
