---
import { Image } from 'astro:assets';
import logo from '../assets/logo/zivis-farm-logo.jpg';
import { hoursPill, nav } from '../data/site';

const path = Astro.url.pathname;
---

<header class="site-header">
  <a class="brand" href="/" aria-label="Zivi's Farm, home">
    <Image src={logo} alt="" width={96} height={96} loading="eager" />
  </a>
  <input id="nav-toggle" class="nav-toggle" type="checkbox" />
  <label class="nav-burger" for="nav-toggle">
    <span></span>
    <span></span>
    <span></span>
    <span class="sr-only">Menu</span>
  </label>
  <nav class="site-nav" aria-label="Primary">
    {
      nav.map((item) => (
        <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
          {item.label}
        </a>
      ))
    }
  </nav>
  <a class="pill" href="/visit/"><span class="pill-long">{hoursPill}</span><span class="pill-short">10–5</span></a>
</header>
