---
import { Image } from 'astro:assets';
import logo from '../assets/logo/zivis-farm-logo.jpg';
import { hoursSummary, site } from '../data/site';

const year = new Date().getFullYear();
const socials = [
  { label: 'Instagram', href: site.social.instagram },
  { label: 'Facebook', href: site.social.facebook },
];
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <a class="footer-brand" href="/">
        <Image src={logo} alt="" width={80} height={80} />
        <strong>{site.name}</strong>
      </a>
      <p>{hoursSummary}</p>
    </div>
    <div>
      <h2>Find us</h2>
      <address>
        {site.address.street}<br />
        {site.address.city}, {site.address.region} {site.address.postalCode}
      </address>
      {site.emailPublic && <p><a href={`mailto:${site.email}`}>{site.email}</a></p>}
    </div>
    <div>
      <h2>Say hello</h2>
      <ul>
        {
          socials.map((item) => (
            <li>
              {item.href ? (
                <a href={item.href}>{item.label}</a>
              ) : (
                <span class="soon-link">{item.label}, soon</span>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <p class="wrap legal">© {year} {site.legalName}</p>
</footer>

<style>
  address {
    font-style: normal;
  }
</style>
